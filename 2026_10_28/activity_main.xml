<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical"
    android:background="#5F9EA0"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Podaj wartość klucza"
        android:textColor="#FAEBD7"
        android:textSize="20sp"/>

    <EditText
        android:id="@+id/klucz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:inputType="text"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Podaj tekst"
        android:textColor="#FAEBD7"
        android:textSize="20sp"/>

    <EditText
        android:id="@+id/tekst"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:inputType="textMultiLine"
        android:lines="3"/>

    <Button
        android:id="@+id/zaszyfruj"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Zaszyfruj"
        android:backgroundTint="#ADD8E6"
        android:textColor="@color/black"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tekst zaszyfrowany"
        android:textColor="#FAEBD7"
        android:textSize="20sp"/>

    <TextView
        android:id="@+id/zaszyforwane"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:textColor="#F0F8FF"/>

    <Button
        android:id="@+id/zapisz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Zapisz szyfr w pliku"
        android:backgroundTint="#ADD8E6"
        android:textColor="@color/black"/>

</LinearLayout>