<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFF8DC">

    <TextView
        android:id="@+id/prostokat"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/white"/>

    <TextView
        android:layout_marginTop="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dobierz kolor suwakami i zapisz przyciskiem"/>

    <LinearLayout
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R"/>
        <SeekBar
            android:id="@+id/r"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:min="0"
            android:max="255"
            android:progress="255"/>
        <TextView
            android:id="@+id/R_wartosc"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:text="255" />
    </LinearLayout>
    <LinearLayout
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="G"/>
        <SeekBar
            android:id="@+id/g"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:min="0"
            android:max="255"
            android:progress="255"/>
        <TextView
            android:id="@+id/G_wartosc"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:text="255" />
    </LinearLayout>
    <LinearLayout
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="B"/>
        <SeekBar
            android:id="@+id/b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:min="0"
            android:max="255"
            android:progress="255"/>
        <TextView
            android:id="@+id/B_wartosc"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:text="255" />
    </LinearLayout>

    <Button
        android:id="@+id/pobierz"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="Pobierz"
        android:layout_gravity="center"
        android:backgroundTint="#CD853F"
        android:textColor="@color/black"/>

    <TextView
        android:layout_marginTop="20dp"
        android:id="@+id/etykieta"
        android:layout_width="150dp"
        android:layout_height="20dp"
        android:background="@color/white"
        android:layout_gravity="center"
        android:text="255, 255, 255"/>

</LinearLayout>