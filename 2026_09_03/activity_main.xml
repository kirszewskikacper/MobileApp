<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/Beige"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/Brown"
            android:text="Gra w kości. Autor 00000000000"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginBottom="10dp"
            android:textSize="20sp"/>

        <Button
            android:id="@+id/Rzut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/Chocolate"
            android:text="Rzuć kośćmi"
            android:layout_gravity="center"
            android:layout_marginVertical="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@color/white"
            android:orientation="horizontal"
            android:layout_marginVertical="10dp">

            <ImageView
                android:id="@+id/kosc1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/question"
                android:layout_marginHorizontal="5dp"/>

            <ImageView
                android:id="@+id/kosc2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/question"
                android:layout_marginHorizontal="5dp"/>

            <ImageView
                android:id="@+id/kosc3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/question"
                android:layout_marginHorizontal="5dp"/>

            <ImageView
                android:id="@+id/kosc4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/question"
                android:layout_marginHorizontal="5dp"/>

            <ImageView
                android:id="@+id/kosc5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:src="@drawable/question"
                android:layout_marginHorizontal="5dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/wynik_losowania"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wynik tego losowania: "
            android:textAlignment="center"
            android:layout_marginVertical="10dp"/>

        <TextView
            android:id="@+id/wynik_gry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wynik gry: "
            android:textAlignment="center"
            android:layout_marginVertical="10dp"/>

        <Button
            android:id="@+id/reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/Chocolate"
            android:text="RESETUJ WYNIK"
            android:layout_gravity="center"
            android:layout_marginVertical="10dp"/>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
