<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical"
    android:background="#B0C4DE">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dane pracownika" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Imię"/>
        <EditText
            android:id="@+id/imie"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:inputType="text"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nazwisko"/>
        <EditText
            android:id="@+id/nazwisko"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:inputType="text"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stanowisko"/>
        <Spinner
            android:id="@+id/stan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>



    <TextView
        android:layout_marginTop="50dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Generowanie hasła"/>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ile znaków?"/>
        <EditText
            android:id="@+id/ilosc_znakow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:inputType="number"/>
    </LinearLayout>

    <CheckBox
        android:id="@+id/male_i_wielkie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Małe i wielkie litery"/>

    <CheckBox
        android:id="@+id/cyfry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cyfry"/>

    <CheckBox
        android:id="@+id/znaki_specjalne"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Znaki specjanle"/>
    <Button
        android:id="@+id/generowanie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="generuj hasło"
        android:backgroundTint="#4682B4"/>

    <Button
        android:layout_marginTop="60dp"
        android:id="@+id/zatwierdz"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Zatwierdź"
        android:backgroundTint="#4682B4"/>


</LinearLayout>